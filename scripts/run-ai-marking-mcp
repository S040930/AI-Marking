#!/usr/bin/env bash
set -Eeuo pipefail

# 可选第一个参数:客户端标识(codex/claude-code/opencode 等),
# 由各客户端注册时的 args 传入,用于后端记录评分来源。
CLIENT_NAME="${1:-}"
if [ -n "$CLIENT_NAME" ]; then
  export AI_MARKING_MCP_CLIENT="$CLIENT_NAME"
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
BACKEND_DIR="$PROJECT_DIR/backend"
PYTHON_BIN="${PYTHON_BIN:-$BACKEND_DIR/.venv/bin/python}"

if [ ! -x "$PYTHON_BIN" ]; then
  echo "未找到后端 Python: $PYTHON_BIN" >&2
  exit 1
fi

cd "$BACKEND_DIR"
exec "$PYTHON_BIN" -m app.mcp.server
