#!/usr/bin/env bash

set -Eeuo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
BACKEND_DIR="$PROJECT_DIR/backend"
ENV_FILE="$BACKEND_DIR/.env"
ENV_EXAMPLE="$BACKEND_DIR/.env.example"
RUNNER="$SCRIPT_DIR/run-ai-marking-mcp"
SERVER_NAME="ai-marking"

info() {
  printf '\033[1;34m%s\033[0m\n' "$1"
}

pass() {
  printf '\033[1;32m✓ %s\033[0m\n' "$1"
}

warn() {
  printf '\033[1;33m! %s\033[0m\n' "$1" >&2
}

fail() {
  printf '\033[1;31m✗ %s\033[0m\n' "$1" >&2
  return 0
}

find_python() {
  if [ -x "$BACKEND_DIR/.venv/bin/python" ]; then
    printf '%s\n' "$BACKEND_DIR/.venv/bin/python"
  elif command -v python3 >/dev/null 2>&1; then
    command -v python3
  else
    return 1
  fi
}

ensure_env_file() {
  if [ ! -f "$ENV_FILE" ]; then
    cp "$ENV_EXAMPLE" "$ENV_FILE"
    chmod 600 "$ENV_FILE"
    pass "已从 backend/.env.example 创建 backend/.env"
  fi
  chmod 600 "$ENV_FILE"
  printf '%s\n' "local"
}

mcp_config_matches() {
  local python_bin config_json
  python_bin="$(find_python)" || return 1
  config_json="$(codex mcp get "$SERVER_NAME" --json 2>/dev/null)" || return 1
  MCP_CONFIG_JSON="$config_json" EXPECTED_RUNNER="$RUNNER" EXPECTED_CWD="$PROJECT_DIR" \
    "$python_bin" - <<'PY'
import json
import os

payload = json.loads(os.environ["MCP_CONFIG_JSON"])
transport = payload.get("transport") or {}
matches = (
    payload.get("enabled") is True
    and transport.get("type") == "stdio"
    and transport.get("command") == os.environ["EXPECTED_RUNNER"]
    and transport.get("args") == []
    and transport.get("cwd") == os.environ["EXPECTED_CWD"]
)
raise SystemExit(0 if matches else 1)
PY
}

register_mcp() {
  command -v codex >/dev/null 2>&1 || {
    fail "未找到 Codex CLI；请先安装或更新 Codex。"
    return 1
  }
  [ -x "$RUNNER" ] || {
    fail "MCP 启动器不可执行：$RUNNER"
    return 1
  }

  if mcp_config_matches; then
    pass "Codex MCP 配置已是最新，无需修改"
    return
  fi

  if codex mcp get "$SERVER_NAME" --json >/dev/null 2>&1; then
    info "正在替换旧的 ai-marking MCP 配置…"
    codex mcp remove "$SERVER_NAME" >/dev/null
  else
    info "正在注册 ai-marking MCP…"
  fi
  (
    cd "$PROJECT_DIR"
    codex mcp add "$SERVER_NAME" -- "$RUNNER" >/dev/null
  )
  pass "已注册 ai-marking MCP"
}

check_backend() {
  local python_bin
  python_bin="$(find_python)" || return 1
  "$python_bin" - <<'PY'
import json
import os
import sys
import urllib.error
import urllib.request

request = urllib.request.Request(
    "http://127.0.0.1:8000/api/mcp/health",
)
try:
    with urllib.request.urlopen(request, timeout=3) as response:
        payload = json.load(response)
except urllib.error.HTTPError as exc:
    if exc.code == 404:
        print("wrong_or_old_service")
    elif exc.code == 503:
        print("service_unavailable")
    else:
        print(f"http_{exc.code}")
    sys.exit(1)
except (urllib.error.URLError, TimeoutError):
    print("offline")
    sys.exit(1)

if payload.get("service") != "ai-marking":
    print("wrong_service")
    sys.exit(1)
if payload.get("mcp_api_version") != "8":
    print("old_api")
    sys.exit(1)
print("ok")
PY
}

doctor() {
  local failures=0 python_bin backend_status
  info "检查 Codex → AI-Marking MCP 接入"

  if command -v codex >/dev/null 2>&1; then
    pass "Codex CLI：$(codex --version 2>/dev/null)"
  else
    fail "未找到 Codex CLI"
    failures=$((failures + 1))
  fi

  if python_bin="$(find_python)"; then
    pass "Python：$python_bin"
    if (
      cd "$BACKEND_DIR"
      "$python_bin" -c 'import app, mcp'
    ) >/dev/null 2>&1; then
      pass "后端与 MCP Python 依赖可用"
    else
      fail "后端依赖不完整；请运行 ./start.sh 安装锁定依赖"
      failures=$((failures + 1))
    fi
  else
    fail "未找到 Python 3"
    failures=$((failures + 1))
  fi

  if [ -x "$RUNNER" ]; then
    pass "MCP 启动器可执行"
  else
    fail "MCP 启动器不存在或不可执行"
    failures=$((failures + 1))
  fi

  if [ -f "$ENV_FILE" ]; then
    pass "本地 backend/.env 已存在（MCP 使用 loopback，无内部 token）"
  else
    fail "backend/.env 不存在；请运行 ./scripts/setup-codex-mcp"
    failures=$((failures + 1))
  fi

  if command -v codex >/dev/null 2>&1 && mcp_config_matches; then
    pass "Codex 中的 ai-marking MCP 路径与工作目录正确"
  else
    fail "Codex MCP 未注册或配置过期；请运行 ./scripts/setup-codex-mcp"
    failures=$((failures + 1))
  fi

  if backend_status="$(check_backend 2>/dev/null)"; then
  pass "AI-Marking MCP API v8、loopback 与数据库连接正常"
  else
    case "$backend_status" in
      offline)
        fail "8000 端口未运行 AI-Marking；请运行 ./start.sh"
        ;;
      wrong_or_old_service | wrong_service)
        fail "8000 端口是其他服务或旧 AI-Marking 进程；请停止后重新运行 ./start.sh"
        ;;
      old_api)
        fail "运行中的 AI-Marking MCP API 不是 v8；请同时重启 ./start.sh 和 Codex MCP"
        ;;
      service_unavailable)
        fail "AI-Marking 数据库或 MCP 配置不可用；请检查后端日志"
        ;;
      *)
        fail "AI-Marking MCP 健康检查失败：${backend_status:-unknown}"
        ;;
    esac
    failures=$((failures + 1))
  fi

  if [ "$failures" -eq 0 ]; then
    pass "Codex → AI-Marking MCP 已完全就绪"
    return 0
  fi
  warn "诊断发现 $failures 项问题"
  return 1
}

setup() {
  info "配置 Codex → AI-Marking MCP"
  ensure_env_file >/dev/null
  pass "本机 .env 已就绪；MCP 使用 loopback，无需内部 token"
  register_mcp
  if doctor; then
    printf '\n'
    pass "接入完成，可在 Codex 拖入报告 PDF（可附代码文件）并输入“使用 AI-Marking 批改”"
  else
    printf '\n'
    warn "配置已完成，但运行态尚未完全就绪。按上方提示修复后运行："
    warn "  ./scripts/setup-codex-mcp --doctor"
  fi
  warn "若 Codex 已打开，请重启 Codex 以加载最新 MCP 配置。"
}

case "${1:-setup}" in
  setup)
    setup
    ;;
  --doctor | doctor)
    doctor
    ;;
  *)
    printf '用法：%s [--doctor]\n' "$0" >&2
    exit 2
    ;;
esac
