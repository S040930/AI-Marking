#!/usr/bin/env python3
"""Migrate uploaded PDFs to content-addressed storage.

The command is intentionally dry-run by default. It never removes a file
outside UPLOAD_DIR and can be safely rerun after an interrupted batch.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import logging
import os
import shutil
import sys
from pathlib import Path

PROJECT_ROOT = Path(__file__).resolve().parents[1]
VENV_PYTHON = PROJECT_ROOT / "backend" / ".venv" / "bin" / "python"
if sys.prefix == sys.base_prefix and VENV_PYTHON.is_file():
    os.execv(str(VENV_PYTHON), [str(VENV_PYTHON), __file__, *sys.argv[1:]])

from sqlalchemy import select  # noqa: E402

sys.path.insert(0, str(PROJECT_ROOT / "backend"))

from app.core.config import settings  # noqa: E402
from app.db.session import SessionLocal  # noqa: E402
from app.models.question import Question  # noqa: E402
from app.models.submission import Submission  # noqa: E402

LOG = logging.getLogger("migrate-document-storage")
BATCH_SIZE = 100
CHUNK_SIZE = 1024 * 1024


def file_digest(path: Path) -> tuple[str, int]:
    digest = hashlib.sha256()
    size = 0
    with path.open("rb") as handle:
        while chunk := handle.read(CHUNK_SIZE):
            size += len(chunk)
            digest.update(chunk)
    return digest.hexdigest(), size


def same_bytes(left: Path, right: Path) -> bool:
    if left.stat().st_size != right.stat().st_size:
        return False
    with left.open("rb") as first, right.open("rb") as second:
        while True:
            a = first.read(CHUNK_SIZE)
            b = second.read(CHUNK_SIZE)
            if a != b:
                return False
            if not a:
                return True


def safe_path(path_value: str, root: Path) -> Path:
    path = Path(path_value).expanduser()
    resolved = path.resolve(strict=False)
    try:
        resolved.relative_to(root)
    except ValueError as exc:
        raise RuntimeError(f"文件路径越界，拒绝处理：{path_value}") from exc
    return resolved


def referenced_paths(db, candidates: set[str]) -> set[str]:  # noqa: ANN001
    refs: set[str] = set()
    for model, columns in (
        (Question, (Question.file_path, Question.replacement_file_path)),
        (Submission, (Submission.file_path,)),
    ):
        for row in db.execute(select(*columns)).all():
            refs.update(str(value) for value in row if value)
    return refs & candidates


def iter_documents(db):  # noqa: ANN001
    for model in (Question, Submission):
        last_id = 0
        while True:
            rows = (
                db.execute(
                    select(model)
                    .where(model.id > last_id)
                    .order_by(model.id)
                    .limit(BATCH_SIZE)
                )
                .scalars()
                .all()
            )
            if not rows:
                break
            yield model, rows
            last_id = rows[-1].id


def migrate(*, apply: bool, clean_legacy_artifacts: bool) -> dict:
    configured_root = Path(settings.UPLOAD_DIR)
    root = (
        configured_root
        if configured_root.is_absolute()
        else PROJECT_ROOT / "backend" / configured_root
    ).resolve()
    report = {
        "upload_root": str(root),
        "apply": apply,
        "batches": 0,
        "files_seen": 0,
        "files_missing": [],
        "files_migrated": 0,
        "bytes_reclaimable": 0,
        "deleted_legacy_artifacts": [],
        "errors": [],
    }
    if not root.exists():
        raise RuntimeError(f"UPLOAD_DIR 不存在：{root}")

    with SessionLocal() as db:
        for model, rows in iter_documents(db):
            report["batches"] += 1
            old_paths: set[str] = set()
            changes: list[tuple[object, str, str, str]] = []
            for row in rows:
                fields = ["file_path"]
                if model is Question:
                    fields.append("replacement_file_path")
                for field in fields:
                    value = getattr(row, field)
                    if not value:
                        continue
                    report["files_seen"] += 1
                    try:
                        source = safe_path(value, root)
                        if not source.is_file():
                            report["files_missing"].append(value)
                            continue
                        digest, size = file_digest(source)
                        target = root / "documents" / digest[:2] / f"{digest}.pdf"
                        if source != target:
                            if apply:
                                target.parent.mkdir(parents=True, exist_ok=True)
                            if target.exists() and not same_bytes(target, source):
                                raise RuntimeError(f"内容哈希冲突：{target}")
                            if apply and not target.exists():
                                shutil.copy2(source, target)
                            old_paths.add(str(source))
                            changes.append((row, field, str(target), digest))
                            report["files_migrated"] += 1
                            report["bytes_reclaimable"] += size
                        elif field == "file_path" and getattr(row, "file_sha256", None) != digest:
                            changes.append((row, field, str(target), digest))
                        elif field == "replacement_file_path" and getattr(row, "replacement_file_sha256", None) != digest:
                            changes.append((row, field, str(target), digest))
                    except Exception as exc:  # report the exact item and stop safely
                        report["errors"].append(f"{model.__name__}.{row.id}.{field}: {exc}")
                        raise

            if apply and changes:
                for row, field, target, digest in changes:
                    setattr(row, field, target)
                    if field == "file_path":
                        row.file_sha256 = digest
                    else:
                        row.replacement_file_sha256 = digest
                db.commit()
                refs = referenced_paths(db, old_paths)
                for old_path in old_paths - refs:
                    old = safe_path(old_path, root)
                    if old.exists():
                        old.unlink()
                        report["bytes_reclaimable"] += 0
            elif not apply:
                db.rollback()

        if apply and clean_legacy_artifacts:
            artifact_root = root / "code-artifacts"
            if artifact_root.is_dir():
                live_ids = set(
                    db.execute(select(Submission.id)).scalars().all()
                )
                for child in artifact_root.iterdir():
                    if child.is_dir() and child.name.isdigit() and int(child.name) not in live_ids:
                        safe_path(str(child), root)
                        shutil.rmtree(child)
                        report["deleted_legacy_artifacts"].append(str(child))

    return report


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--apply", action="store_true", help="提交数据库更新并删除无引用旧文件")
    parser.add_argument("--clean-legacy-artifacts", action="store_true")
    parser.add_argument("--report", type=Path)
    args = parser.parse_args()
    logging.basicConfig(level=logging.INFO, format="%(levelname)s %(message)s")
    try:
        report = migrate(
            apply=args.apply,
            clean_legacy_artifacts=args.clean_legacy_artifacts,
        )
    except Exception as exc:
        report = {
            "apply": args.apply,
            "errors": [str(exc)],
        }
    text = json.dumps(report, ensure_ascii=False, indent=2)
    print(text)
    if args.report:
        args.report.write_text(text + "\n", encoding="utf-8")
    return 1 if report["errors"] else 0


if __name__ == "__main__":
    raise SystemExit(main())
