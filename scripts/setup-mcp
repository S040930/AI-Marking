#!/usr/bin/env bash
# AI-Marking MCP 通用客户端注册脚本。
# 支持任意实现了 stdio MCP 的编程助手客户端;内置 codex / claude / opencode。

set -Eeuo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
BACKEND_DIR="$PROJECT_DIR/backend"
ENV_FILE="$BACKEND_DIR/.env"
ENV_EXAMPLE="$BACKEND_DIR/.env.example"
RUNNER="$SCRIPT_DIR/run-ai-marking-mcp"
SERVER_NAME="ai-marking"
MCP_API_VERSION_EXPECTED="9"

CLIENT=""
MODE="setup"

info() {
  printf '\033[1;34m%s\033[0m\n' "$1"
}

pass() {
  printf '\033[1;32m✓ %s\033[0m\n' "$1"
}

warn() {
  printf '\033[1;33m! %s\033[0m\n' "$1" >&2
}

fail() {
  printf '\033[1;31m✗ %s\033[0m\n' "$1" >&2
  return 0
}

usage() {
  printf '用法：%s --client codex|claude|opencode [--doctor]\n' "$0" >&2
  exit 2
}

while [ $# -gt 0 ]; do
  case "$1" in
    --client)
      [ $# -ge 2 ] || usage
      CLIENT="$2"
      shift 2
      ;;
    --doctor | doctor)
      MODE="doctor"
      shift
      ;;
    *)
      usage
      ;;
  esac
done

[ -n "$CLIENT" ] || usage

case "$CLIENT" in
  codex) CLIENT_SLUG="codex" ;;
  claude) CLIENT_SLUG="claude-code" ;;
  opencode) CLIENT_SLUG="opencode" ;;
  *)
    fail "未知客户端：$CLIENT（当前内置 codex / claude / opencode）"
    exit 2
    ;;
esac

find_python() {
  if [ -x "$BACKEND_DIR/.venv/bin/python" ]; then
    printf '%s\n' "$BACKEND_DIR/.venv/bin/python"
  elif command -v python3 >/dev/null 2>&1; then
    command -v python3
  else
    return 1
  fi
}

ensure_env_file() {
  if [ ! -f "$ENV_FILE" ]; then
    cp "$ENV_EXAMPLE" "$ENV_FILE"
    chmod 600 "$ENV_FILE"
    pass "已从 backend/.env.example 创建 backend/.env"
  fi
  chmod 600 "$ENV_FILE"
}

# ---------- codex ----------

codex_config_matches() {
  local python_bin config_json
  python_bin="$(find_python)" || return 1
  config_json="$(codex mcp get "$SERVER_NAME" --json 2>/dev/null)" || return 1
  MCP_CONFIG_JSON="$config_json" EXPECTED_RUNNER="$RUNNER" EXPECTED_CWD="$PROJECT_DIR" EXPECTED_CLIENT="$CLIENT_SLUG" \
    "$python_bin" - <<'PY'
import json
import os

payload = json.loads(os.environ["MCP_CONFIG_JSON"])
transport = payload.get("transport") or {}
matches = (
    payload.get("enabled") is True
    and transport.get("type") == "stdio"
    and transport.get("command") == os.environ["EXPECTED_RUNNER"]
    and transport.get("args") == [os.environ["EXPECTED_CLIENT"]]
    and transport.get("cwd") == os.environ["EXPECTED_CWD"]
)
raise SystemExit(0 if matches else 1)
PY
}

register_codex() {
  command -v codex >/dev/null 2>&1 || {
    fail "未找到 Codex CLI；请先安装或更新 Codex。"
    return 1
  }
  [ -x "$RUNNER" ] || {
    fail "MCP 启动器不可执行：$RUNNER"
    return 1
  }

  if codex_config_matches; then
    pass "Codex MCP 配置已是最新，无需修改"
    return
  fi

  if codex mcp get "$SERVER_NAME" --json >/dev/null 2>&1; then
    info "正在替换 Codex 中的旧 ai-marking MCP 配置…"
    codex mcp remove "$SERVER_NAME" >/dev/null
  else
    info "正在向 Codex 注册 ai-marking MCP…"
  fi
  (
    cd "$PROJECT_DIR"
    codex mcp add "$SERVER_NAME" -- "$RUNNER" "$CLIENT_SLUG" >/dev/null
  )
  pass "已在 Codex 注册 ai-marking MCP"
}

doctor_codex() {
  command -v codex >/dev/null 2>&1 || {
    fail "未找到 Codex CLI"
    return 1
  }
  if codex_config_matches; then
    pass "Codex 中的 ai-marking MCP 路径与工作目录正确"
  else
    fail "Codex MCP 未注册或配置过期；请运行 ./scripts/setup-mcp --client codex"
    return 1
  fi
}

# ---------- claude ----------

register_claude() {
  command -v claude >/dev/null 2>&1 || {
    fail "未找到 Claude Code CLI；请先安装 claude。"
    return 1
  }
  [ -x "$RUNNER" ] || {
    fail "MCP 启动器不可执行：$RUNNER"
    return 1
  }

  if claude_config_matches; then
    pass "Claude Code MCP 配置已是最新，无需修改"
    return
  fi

  info "正在向 Claude Code 注册 ai-marking MCP…"
  claude mcp remove "$SERVER_NAME" -s local >/dev/null 2>&1 || true
  claude mcp add "$SERVER_NAME" -s local -- "$RUNNER" "$CLIENT_SLUG" >/dev/null
  pass "已在 Claude Code 注册 ai-marking MCP（local 作用域）"
}

claude_config_matches() {
  local output
  output="$(claude mcp get "$SERVER_NAME" 2>/dev/null)" || return 1
  printf '%s' "$output" | grep -q "$RUNNER"
}

doctor_claude() {
  command -v claude >/dev/null 2>&1 || {
    fail "未找到 Claude Code CLI"
    return 1
  }
  if claude_config_matches; then
    pass "Claude Code 中的 ai-marking MCP 配置正确"
  else
    fail "Claude Code MCP 未注册或配置过期；请运行 ./scripts/setup-mcp --client claude"
    return 1
  fi
}

# ---------- opencode ----------
# opencode mcp add 是交互式命令，脚本改为直接合并其全局配置文件。

OPENCODE_CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/opencode"
OPENCODE_CONFIG_FILE="$OPENCODE_CONFIG_DIR/opencode.json"

register_opencode() {
  command -v opencode >/dev/null 2>&1 || {
    fail "未找到 opencode CLI；请先安装 opencode。"
    return 1
  }
  [ -x "$RUNNER" ] || {
    fail "MCP 启动器不可执行：$RUNNER"
    return 1
  }
  local python_bin rc=0
  python_bin="$(find_python)" || return 1
  mkdir -p "$OPENCODE_CONFIG_DIR"
  OPENCODE_CONFIG_FILE="$OPENCODE_CONFIG_FILE" SERVER_NAME="$SERVER_NAME" RUNNER="$RUNNER" CLIENT_SLUG="$CLIENT_SLUG" \
    "$python_bin" - <<'PY' || rc=$?
import json
import os

path = os.environ["OPENCODE_CONFIG_FILE"]
try:
    with open(path, encoding="utf-8") as handle:
        config = json.load(handle)
except (FileNotFoundError, ValueError):
    config = {}
if not isinstance(config, dict):
    config = {}
mcp = config.get("mcp")
if not isinstance(mcp, dict):
    mcp = {}
unchanged = mcp.get(os.environ["SERVER_NAME"]) == {
    "type": "local",
    "command": [os.environ["RUNNER"], os.environ["CLIENT_SLUG"]],
    "enabled": True,
}
mcp[os.environ["SERVER_NAME"]] = {
    "type": "local",
    "command": [os.environ["RUNNER"], os.environ["CLIENT_SLUG"]],
    "enabled": True,
}
config["mcp"] = mcp
with open(path, "w", encoding="utf-8") as handle:
    json.dump(config, handle, ensure_ascii=False, indent=2)
    handle.write("\n")
raise SystemExit(0 if unchanged else 2)
PY
  case "$rc" in
    0)
      pass "opencode MCP 配置已是最新，无需修改"
      ;;
    2)
      pass "已在 opencode 全局配置注册 ai-marking MCP（$OPENCODE_CONFIG_FILE）"
      ;;
    *)
      fail "写入 opencode 配置失败：$OPENCODE_CONFIG_FILE"
      return 1
      ;;
  esac
}

doctor_opencode() {
  command -v opencode >/dev/null 2>&1 || {
    fail "未找到 opencode CLI"
    return 1
  }
  local python_bin
  python_bin="$(find_python)" || return 1
  if OPENCODE_CONFIG_FILE="$OPENCODE_CONFIG_FILE" SERVER_NAME="$SERVER_NAME" RUNNER="$RUNNER" CLIENT_SLUG="$CLIENT_SLUG" \
    "$python_bin" - <<'PY'
import json
import os
import sys

path = os.environ["OPENCODE_CONFIG_FILE"]
try:
    with open(path, encoding="utf-8") as handle:
        config = json.load(handle)
except (FileNotFoundError, ValueError):
    sys.exit(1)
entry = (config.get("mcp") or {}).get(os.environ["SERVER_NAME"])
expected = {
    "type": "local",
    "command": [os.environ["RUNNER"], os.environ["CLIENT_SLUG"]],
    "enabled": True,
}
sys.exit(0 if entry == expected else 1)
PY
  then
    pass "opencode 中的 ai-marking MCP 配置正确"
  else
    fail "opencode MCP 未注册或配置过期；请运行 ./scripts/setup-mcp --client opencode"
    return 1
  fi
}

# ---------- 后端健康检查 ----------

check_backend() {
  local python_bin
  python_bin="$(find_python)" || return 1
  "$python_bin" - <<PY
import json
import sys
import urllib.error
import urllib.request

request = urllib.request.Request(
    "http://127.0.0.1:8000/api/mcp/health",
)
try:
    with urllib.request.urlopen(request, timeout=3) as response:
        payload = json.load(response)
except urllib.error.HTTPError as exc:
    if exc.code == 404:
        print("wrong_or_old_service")
    elif exc.code == 503:
        print("service_unavailable")
    else:
        print(f"http_{exc.code}")
    sys.exit(1)
except (urllib.error.URLError, TimeoutError):
    print("offline")
    sys.exit(1)

if payload.get("service") != "ai-marking":
    print("wrong_service")
    sys.exit(1)
if payload.get("mcp_api_version") != "$MCP_API_VERSION_EXPECTED":
    print("old_api")
    sys.exit(1)
print("ok")
PY
}

doctor() {
  local failures=0 python_bin backend_status client_label

  case "$CLIENT" in
    codex) client_label="Codex CLI" ;;
    claude) client_label="Claude Code CLI" ;;
    opencode) client_label="opencode CLI" ;;
  esac
  info "检查 $client_label → AI-Marking MCP 接入"

  if command -v "$CLIENT" >/dev/null 2>&1; then
    pass "$client_label：$("$CLIENT" --version 2>/dev/null | head -n1)"
  else
    fail "未找到 $client_label"
    failures=$((failures + 1))
  fi

  if python_bin="$(find_python)"; then
    pass "Python：$python_bin"
    if (
      cd "$BACKEND_DIR"
      "$python_bin" -c 'import app, mcp'
    ) >/dev/null 2>&1; then
      pass "后端与 MCP Python 依赖可用"
    else
      fail "后端依赖不完整；请运行 ./start.sh 安装锁定依赖"
      failures=$((failures + 1))
    fi
  else
    fail "未找到 Python 3"
    failures=$((failures + 1))
  fi

  if [ -x "$RUNNER" ]; then
    pass "MCP 启动器可执行"
  else
    fail "MCP 启动器不存在或不可执行"
    failures=$((failures + 1))
  fi

  if [ -f "$ENV_FILE" ]; then
    pass "本地 backend/.env 已存在（MCP 使用 loopback，无内部 token）"
  else
    fail "backend/.env 不存在；请运行 ./scripts/setup-mcp --client $CLIENT"
    failures=$((failures + 1))
  fi

  case "$CLIENT" in
    codex) doctor_codex || failures=$((failures + 1)) ;;
    claude) doctor_claude || failures=$((failures + 1)) ;;
    opencode) doctor_opencode || failures=$((failures + 1)) ;;
  esac

  if backend_status="$(check_backend 2>/dev/null)"; then
    pass "AI-Marking MCP API v$MCP_API_VERSION_EXPECTED、loopback 与数据库连接正常"
  else
    case "$backend_status" in
      offline)
        fail "8000 端口未运行 AI-Marking；请运行 ./start.sh"
        ;;
      wrong_or_old_service | wrong_service)
        fail "8000 端口是其他服务或旧 AI-Marking 进程；请停止后重新运行 ./start.sh"
        ;;
      old_api)
        fail "运行中的 AI-Marking MCP API 不是 v$MCP_API_VERSION_EXPECTED；请同时重启 ./start.sh 和客户端 MCP"
        ;;
      service_unavailable)
        fail "AI-Marking 数据库或 MCP 配置不可用；请检查后端日志"
        ;;
      *)
        fail "AI-Marking MCP 健康检查失败：${backend_status:-unknown}"
        ;;
    esac
    failures=$((failures + 1))
  fi

  if [ "$failures" -eq 0 ]; then
    pass "$client_label → AI-Marking MCP 已完全就绪"
    return 0
  fi
  warn "诊断发现 $failures 项问题"
  return 1
}

setup() {
  info "配置 $CLIENT → AI-Marking MCP"
  ensure_env_file >/dev/null
  pass "本机 .env 已就绪；MCP 使用 loopback，无需内部 token"
  case "$CLIENT" in
    codex) register_codex ;;
    claude) register_claude ;;
    opencode) register_opencode ;;
  esac
  if doctor; then
    printf '\n'
    pass "接入完成，可在 $CLIENT 拖入报告 PDF（可附代码文件）并输入“使用 AI-Marking 批改”"
  else
    printf '\n'
    warn "配置已完成，但运行态尚未完全就绪。按上方提示修复后运行："
    warn "  ./scripts/setup-mcp --client $CLIENT --doctor"
  fi
  warn "若 $CLIENT 已打开，请重启 $CLIENT 以加载最新 MCP 配置。"
}

case "$MODE" in
  setup)
    setup
    ;;
  doctor)
    doctor
    ;;
esac
