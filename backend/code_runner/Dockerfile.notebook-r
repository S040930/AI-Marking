FROM rocker/r-ver:4.4.3
COPY requirements-notebook.txt /runner/requirements-notebook.txt
RUN apt-get update && apt-get install -y --no-install-recommends \
       build-essential gfortran libzmq3-dev uuid-dev python3 python3-venv \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m venv /opt/runner-venv \
    && /opt/runner-venv/bin/pip install --no-cache-dir pip==24.3.1 \
    && /opt/runner-venv/bin/pip install --no-cache-dir --only-binary=:all: \
       -r /runner/requirements-notebook.txt \
    && Rscript -e 'options(repos=c(CRAN="https://packagemanager.posit.co/cran/2024-12-01")); install.packages("IRkernel"); stopifnot(as.character(packageVersion("IRkernel")) == "1.3.2"); IRkernel::installspec(user=FALSE)'
COPY case_runner.py /runner/case_runner.py
ENV PATH="/opt/runner-venv/bin:${PATH}"
ENV HOME=/tmp JUPYTER_RUNTIME_DIR=/tmp/jupyter/runtime IPYTHONDIR=/tmp/ipython R_USER=/tmp
ENTRYPOINT []
