DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ai_marking
CORS_ORIGINS=["http://localhost:5173"]
UPLOAD_DIR=./uploads
# 已进入终态或失败的上传 PDF 最多保留天数,超过由后台清理任务删除
UPLOAD_RETENTION_DAYS=7
# 后台清理任务扫描间隔(秒)
CLEANUP_INTERVAL_SECONDS=3600
TASK_CONCURRENCY=4
TASK_LEASE_SECONDS=90
TASK_MAX_ATTEMPTS=3
TASK_POLL_INTERVAL_SECONDS=1
# Codex 评分上下文总长度限制（超过后需拆分作业或缩减提交内容）
MCP_MAX_GRADING_CONTEXT_CHARS=200000
