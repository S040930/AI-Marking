# ⚠️ 以下为本地开发默认口令（postgres:postgres），仅适用于本机 PostgreSQL。
# 生产/共享环境必须改为强口令，并避免将数据库暴露到非本机地址。
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ai_marking
CORS_ORIGINS=["http://localhost:5173"]
UPLOAD_DIR=./uploads
# 无数据库引用孤儿文件的清理宽限期；任何仍被业务记录引用的文件不会定期删除
UPLOAD_RETENTION_DAYS=7
# 后台清理任务扫描间隔(秒)
CLEANUP_INTERVAL_SECONDS=3600
TASK_CONCURRENCY=2
TASK_LEASE_SECONDS=90
TASK_MAX_ATTEMPTS=3
TASK_POLL_INTERVAL_SECONDS=1
# 编程助手评分上下文总长度限制（超过后需拆分作业或缩减提交内容）
MCP_MAX_GRADING_CONTEXT_CHARS=200000
# 全站访问令牌（留空 = 鉴权关闭）。设置后网页登录门与编程助手 MCP 都需
# 此令牌：前端登录页提交一次，后端以 httpOnly Cookie 维持浏览器会话
# （令牌不进 URL/历史/日志）。生成方式：
# python -c "import secrets; print(secrets.token_urlsafe(32))"
ACCESS_TOKEN=
# 实时事件(SSE)连接上限,须远小于 PG max_connections(默认 100)减去
# 业务连接池(10)与安全余量;单机本地工具实际峰值仅个位数连接。
MAX_SSE_CLIENTS=16
