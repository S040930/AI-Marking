{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "api:generate": "openapi-typescript src/api/openapi.json -o src/api/generated.ts",
    "api:check": "npm run api:generate && git diff --exit-code -- src/api/openapi.json src/api/generated.ts",
    "lint": "oxlint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@hookform/resolvers": "5.4.0",
    "@tanstack/react-query": "5.101.2",
    "axios": "1.18.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dayjs": "1.11.21",
    "lucide-react": "1.22.0",
    "radix-ui": "1.6.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-dropzone": "15.0.0",
    "react-hook-form": "7.80.0",
    "react-router-dom": "7.18.2",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.13.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "jsdom": "25.0.1",
    "openapi-typescript": "7.13.0",
    "oxlint": "1.72.0",
    "prettier": "3.9.4",
    "tailwindcss": "4.3.2",
    "typescript": "5.9.3",
    "vite": "8.1.0",
    "vite-plugin-compression2": "2.5.3",
    "vitest": "3.2.6"
  }
}
